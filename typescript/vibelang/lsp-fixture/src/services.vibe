// The prelude, a service, and a plain function. Effect and TaggedError need
// no import in a .vibe file.
export class Missing extends TaggedError("Missing")<{ readonly id: number }> {}

export abstract class Users {
  abstract find(id: number): Effect<string, Missing, never>
}

// No Effect operation and no failure: this compiles to plain JavaScript.
export function double(n: number) {
  return n * 2
}

export function greet(id: number) {
  const name = Users.find(id)
  return `${name} scored ${double(id)}`
}
