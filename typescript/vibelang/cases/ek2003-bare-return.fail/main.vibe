// expect: EK2003
// A plain return annotation keeps its type on a function that compiles to
// plain JavaScript (D67). A function whose body runs an Effect returns
// Effect<A, E, R>, so a plain annotation there is EK2003. A throw under a
// plain annotation is JavaScript's throw, not EK2003 (D263;
// plain-contract-exceptions covers it).
import { Console } from "effect"

export function add(a: number, b: number): number {
  return a + b
}

export function greet(name: string): number {
  Console.log(`hello, ${name}`)
  return name.length
}
