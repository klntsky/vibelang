import { checkNested } from "./caller.js"
import { Effect } from "effect"
function functionValue(): (() => number)!! { return () => 3 }
function objectValue(): object!! { return () => 4 }
function unionValue(): (number | (() => number))!! { return () => 5 }
export let setups = 0
export function nested(): Effect.Effect<Effect.Effect<number>, never, never> {
  setups++
  return () => 6
}
// expect-result: [1,2,3,"function","function",true]
export function main() {
  const a = Effect.suspend(() => () => 1)
  const b = Effect.flatMap(Effect.succeed(0), () => () => 2)
  return [a(), b(), functionValue()(), typeof objectValue(), typeof unionValue(), sync((run: () => boolean) => run(), checkNested)]
}
