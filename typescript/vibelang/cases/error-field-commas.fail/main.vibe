// expect: EK1013
// An error, schema error, service, or control body is a class body (D278,
// D128): ; or a new line separates its fields, and a comma after a field is
// EK1013, not TypeScript's "Expected '=' for property initializer.". A schema
// body is an object type, where a comma separates fields as in TypeScript.

error OutOfStock { sku: string, available: number }

abstract error Missing {
  path: string,
  reason: string,
}

error Gone extends Missing { since: number, by: string }

schema error Rejected { sku: string, reason: string }

service Stock {
  region: string,
  count(sku: string): number!!
}

control Ask {
  limit: number,
  ask(): number!!
}

schema Item { sku: string, available: number }
