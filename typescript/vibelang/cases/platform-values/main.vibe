// D108: importing a platform API and passing it as a value runs nothing, so
// .vibe code can hand Node's functions to the Effect APIs that run them, as
// NodeHttpServer.layer(createServer, { port }) does.
import { createServer } from "node:http"
import * as os from "node:os"
import { kind } from "./kind.ts"

// expect-result: ["function","string"]
export function main() {
  return [kind(createServer), kind(os.EOL)]
}
