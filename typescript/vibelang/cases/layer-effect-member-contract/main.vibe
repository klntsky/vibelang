// A Layer.effect member may use a service the program captured when the layer
// was built, or look one up when it is called if its contract lists it
// (Chapter 4, "Requirements that would leak"); the program may build the
// object in a variable before returning it.
service Clock2 { now(): Effect<number> }
service Greeter { greet(name: string): Effect<string> }
service Stamped { greet(name: string): Effect<string, never, Clock2> }
service Builder { greet(name: string): Effect<string> }

const Clock2Live = Layer.succeed(Clock2, { now() { return 42 } })

const GreeterLive = Layer.effect(Greeter) {
  const clock = Clock2()
  return { greet(name) { return `hi ${name} at ${clock.now()}` } }
}

const StampedLive = Layer.effect(Stamped) {
  return { greet(name) { return `hi ${name} at ${Clock2.now()}` } }
}

const BuilderLive = Layer.effect(Builder) {
  const clock = Clock2()
  const impl = { greet(name: string) { return `built ${name} at ${clock.now()}` } }
  return impl
}

// expect-result: ["hi a at 42","hi b at 42","built c at 42"]
export function main() {
  provide wire(Clock2Live, GreeterLive, StampedLive, BuilderLive) {
    return [Greeter.greet("a"), Stamped.greet("b"), Builder.greet("c")]
  }
}
