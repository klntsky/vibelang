// expect: EK2001 EK2002 EK2101
// D308: a type argument left out of a contract is never, and the compiler
// checks it as never. Effect<string> rejects the failure and the service the
// body needs; Effect<string, Gone> rejects the service. A service member
// still writes an Effect type: a bare return type is EK2101.
error Gone { id: string }

service Users {
  find(id: string): Effect<string, Gone>
  count(): number
}

export function find(id: string): Effect<string> {
  return Users.find(id)
}

export function lookup(id: string): Effect<string, Gone> {
  return Users.find(id)
}
