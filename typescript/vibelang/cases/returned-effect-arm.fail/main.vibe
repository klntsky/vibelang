// expect: EK4802
// Each returned arm or operand that is an Effect value is what the caller
// gets, as a returned Effect value is: the call in the other arm runs, and
// this one is the success value. EK4802 is an error here (tsconfig.json).
interface Hooks {
  emit: (n: number) => Effect<void>
  sleep: (n: number) => Effect<void>
  cached: (n: number | undefined) => Effect<void>
}

export const hooks: Hooks = {
  emit: (n) => {
    return n === 0 ? Effect.interrupt : Console.log("emit", n)
  },
  sleep: (n) => n <= 2 ? Console.log("sleep", n) : (Effect.never),
  cached: (n) => n ?? Effect.interrupt,
}

export function unannotated(n: number) {
  return n === 0 ? Effect.interrupt : n === 1 ? Effect.never : Console.log("call", n)
}

// Both arms are programs: a factory, which runs the chosen one.
export const both = (n: number): Effect<void> => n === 0 ? Effect.interrupt : Effect.void

// A called arm runs, as EK4802's quick fix writes it.
export const called = (n: number): Effect<void> => n === 0 ? Effect.interrupt() : Console.log("emit", n)
