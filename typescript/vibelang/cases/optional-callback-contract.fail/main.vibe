// expect: EK2001 EK2002
// An optional call of a callback without a contract runs the callback, as a
// required call does, so the callback's E and R reach the contract.
export error Late { label: string }

export const coalesced = (label?: (seconds: number) => Late): Effect<Late> => {
  return label?.(2) ?? new Late({ label: "default" })
}

export function announced(log?: (n: number) => void): Effect<boolean> {
  log?.(2)
  return true
}
