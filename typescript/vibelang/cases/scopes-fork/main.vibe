// fork starts a fiber that its block owns (D19, D47): the block is a Scope
// region even without using, and when the block exits by any path it
// interrupts the fiber and waits for its cleanup before it releases what it
// acquired earlier. Fiber.join waits for the fiber. A fork that no block
// encloses is Effect.forkScoped, and Effect's own fork combinators keep
// their meaning.
import { Data, Effect, Fiber } from "effect"
import { fork } from "vibelang-runtime"

class Boom extends Data.TaggedError("Boom")<{}> {}

const events: string[] = []

function resource(name: string) {
  return Effect.acquireRelease(
    () => {
      events.push(`acquire ${name}`)
      return name
    },
    () => {
      events.push(`release ${name}`)
    }
  )
}

// Runs until it is interrupted.
function ticker(name: string) {
  try {
    while (true) {
      Effect.sleep("1 millis")
    }
  } finally {
    events.push(`stop ${name}`)
  }
}

function compute(n: number) {
  Effect.sleep("1 millis")
  events.push(`computed ${n}`)
  return n * 2
}

function boom() {
  Effect.sleep("1 millis")
  throw new Boom()
}

// The ticker stops before the server, acquired earlier, is released.
function serve() {
  using server = resource("server")
  fork(() => ticker("ticker"))
  Effect.sleep("5 millis")
  return `served by ${server}`
}

// Fiber.join waits for the child and returns its result.
function joined() {
  const child = fork(() => compute(21))
  events.push("parent goes on")
  return Fiber.join(child)
}

// A fork in an inner block stops when that block exits.
function inner() {
  {
    fork(() => ticker("inner"))
    Effect.sleep("2 millis")
  }
  events.push("after inner block")
  return "inner done"
}

// A fork in a loop body stops at the end of its iteration.
function perIteration() {
  for (const n of [1, 2]) {
    fork(() => ticker(`loop ${n}`))
    Effect.sleep("2 millis")
    events.push(`end of iteration ${n}`)
  }
  return "loop done"
}

// The child's failure reaches the parent only through Fiber.join.
function failingChild() {
  const child = fork(() => boom())
  try {
    Fiber.join(child)
  } catch (e) {
    return `joined ${e._tag}`
  }
  return "no failure"
}

// A block that fails still stops its fibers.
function failingBlock() {
  fork(() => ticker("doomed"))
  Effect.sleep("2 millis")
  throw new Boom()
}

// No block: fork is Effect.forkScoped, and the caller's Scope owns the fiber.
const background = (name: string) => fork(() => ticker(name))

function scopedBackground() {
  return Effect.scoped(() => {
    background("background")
    Effect.sleep("2 millis")
    events.push("scope closing")
    return "scoped done"
  })
}

// Effect.forkScoped keeps Effect's meaning: the caller's Scope owns the
// fiber, so it outlives the block that forked it.
function outlives() {
  using block = resource("block")
  Effect.forkScoped(() => ticker("forkScoped"))
  return block
}

function scopedCaller() {
  return Effect.scoped(() => {
    const result = outlives()
    events.push("block exited")
    Effect.sleep("2 millis")
    return result
  })
}

// Effect.forkDetach keeps Effect's meaning: the fiber outlives the block.
function detached() {
  const fiber = Effect.forkDetach(() => compute(1))
  return fiber
}

function phase<A>(name: string, result: A) {
  events.push(`-- ${name}`)
  return result
}

// expect-result: {"served":"served by server","joined":42,"inner":"inner done","loop":"loop done","failing":"joined Boom","failedBlock":"Boom","scoped":"scoped done","outlives":"block","detached":2,"events":["acquire server","stop ticker","release server","-- served","parent goes on","computed 21","-- joined","stop inner","after inner block","-- inner","end of iteration 1","stop loop 1","end of iteration 2","stop loop 2","-- loop","-- failing","stop doomed","-- failedBlock","scope closing","stop background","-- scoped","acquire block","release block","block exited","stop forkScoped","-- outlives","computed 1","-- detached"]}
export function main() {
  const served = phase("served", serve())
  const j = phase("joined", joined())
  const i = phase("inner", inner())
  const l = phase("loop", perIteration())
  const f = phase("failing", failingChild())
  let failedBlock = "none"
  try {
    failingBlock()
  } catch (e) {
    failedBlock = e._tag
  }
  phase("failedBlock", failedBlock)
  const s = phase("scoped", scopedBackground())
  const o = phase("outlives", scopedCaller())
  const fiber = detached()
  const d = Fiber.join(fiber)
  phase("detached", d)
  return { served, joined: j, inner: i, loop: l, failing: f, failedBlock, scoped: s, outlives: o, detached: d, events }
}
