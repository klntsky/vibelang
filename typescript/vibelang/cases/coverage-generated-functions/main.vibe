// V8 coverage counts one function for each function the author wrote: the
// thunks, generators, and immediately invoked functions the compiler makes map
// to no source position, so run.mjs lists only these.
error Oops { n: number }
error Bad { code: string }

service Users {
  find(id: string): Effect<string, Bad>
}

export const UsersLive = Layer.succeed(Users, {
  find(id) {
    if (id !== "42") throw new Bad({ code: id })
    return "Ada"
  }
})

export function step(n: number): Effect<number, Oops> {
  if (n < 0) throw new Oops({ n })
  return n
}

export function direct(n: number): Effect<number, Oops> {
  return step(n)
}

export const handler = (base: number) => (n: number) => step(base + n)

function mapped(cause: Oops): Bad {
  return new Bad({ code: String(cause.n) })
}

export function load(n: number): Effect<number, Bad> {
  const a = step(n) catch (cause) => throw mapped(cause)
  return a + 1
}

export function orZero(n: number): Effect<number> {
  return step(n) catch 0
}

export function timed(n: number) {
  return timeout(step(n), "1 second")
}

export function pair(n: number): Effect<number, Oops> {
  const [x, y] = Effect.all([step(n), step(n + 1)])
  return x + y
}

export function nameOf(id: string): Effect<string, never, Users> {
  return Users.find(id) catch "missing"
}

export function label(n: number): string {
  const kind = match (n) { when 0: "zero"; default: "some"; }
  return kind
}

export function guarded(n: number): Effect<number> {
  try {
    return step(n)
  } catch (e) {
    return 0
  }
}

export function block(n: number): Effect<number, Oops> {
  const v = do { const a = step(n); a + 1 }
  return v
}

export function traced(n: number): Effect<number, Oops> {
  return withSpan("traced") {
    const v = step(n)
    return v
  }
}

export function unused(n: number): Effect<number, Bad> {
  return step(n) catch (cause) => throw mapped(cause)
}

export function double(n: number) {
  return n * 2
}
