// A declared Effect const holds a conditional initializer (D269): its value
// is one of the branches, so neither branch runs when the const is
// initialized, and the chosen branch runs each time the const is run. Only
// the condition is evaluated at initialization.
const count = (state: { mutable runs: number }): Effect<number> => {
  state.runs++
  return state.runs
}

const pick = (state: { mutable runs: number }, fixed: number | undefined): Effect<number> => {
  const program: Effect<number> = fixed === undefined ? count(state) : Effect.succeed(fixed)
  return program() + program()
}

// expect-result: [[0,0,1],[2,0,1],[3,14,3]]
export function main() {
  const left = { runs: 0 }
  const right = { runs: 0 }
  const checks = { runs: 0 }
  const fromCall: Effect<number> = right.runs === 0 ? count(left) : count(right)
  const fromSucceed: Effect<number> = ((checks.runs++, left.runs === 0) ? Effect.succeed(7) : count(right)) as Effect<number>
  const before = [left.runs, right.runs, checks.runs]
  const a = fromCall() + fromCall()
  const after = [left.runs, right.runs, checks.runs]
  const b = fromSucceed() + fromSucceed()
  return [before, after, [a, b, pick({ runs: 0 }, undefined)]]
}
