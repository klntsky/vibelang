// expect-result: {"single":"hi","mixed":"Ada hi","module":7,"qualified":7,"both":"Ada 7","called":"Ada hi"}
// provide Key = value provides one service (D173). Every function here
// declares no dependencies (!!), so each provide block must remove the keys
// its body needs.
service Greeting {
  text(): Effect<string>
}

service Names {
  name(): Effect<string>
}

const NamesLive = Layer.succeed(Names, {
  name() { return "Ada" }
})

const fixedRandom = { nextIntUnsafe: () => 7, nextDoubleUnsafe: () => 0.25 }

function single(): Effect<string> {
  provide Greeting = { text: () => "hi" } {
    return Greeting.text()
  }
}

// Layers and services mix in one list.
function mixed(): Effect<string> {
  provide NamesLive, Greeting = { text: () => "hi" } {
    return `${Names.name()} ${Greeting.text()}`
  }
}

// An effect module stands for its key of the same name: Random is Random.Random.
function module(): Effect<number> {
  provide Random = fixedRandom {
    return Random.nextInt()
  }
}

function qualified(): Effect<number> {
  provide Random.Random = fixedRandom {
    return Random.nextInt()
  }
}

function both(): Effect<string> {
  provide NamesLive, Random = fixedRandom {
    return `${Names.name()} ${Random.nextInt()}`
  }
}

// The call shape means the same: provide(...) { ... } is provide ... { ... }.
function called(): Effect<string> {
  provide(NamesLive, Greeting = { text: () => "hi" }) {
    return `${Names.name()} ${Greeting.text()}`
  }
}

export function main() {
  return { single: single(), mixed: mixed(), module: module(), qualified: qualified(), both: both(), called: called() }
}
