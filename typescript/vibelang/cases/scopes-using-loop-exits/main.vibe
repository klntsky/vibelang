x1","source closed"]],"streambreak":[false,["body","dispose local","dispose x1","source closed"]],"streamreturn":[false,["body","dispose local","dispose x1","source closed"]],"streamcontinue":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"streamInterrupted":["body","dispose local","dispose x1","source closed"],"concurrentsuccess":[false,["body","dispose x1","body","dispose x2"]],"concurrentfailure":[true,["body","dispose x1"]],"concurrentdefect":[true,["body","dispose x1"]],"concurrentcontinue":[false,["body","dispose x1","body","dispose x2"]],"concurrentInterrupted":["body","dispose x1"]}
export function main() {
  return {
    arraysuccess: array("success"),
    arrayfailure: array("failure"),
    arraydefect: array("defect"),
    arraybreak: array("break"),
    arrayreturn: array("return"),
    arraycontinue: array("continue"),
    arrayInterrupted: arrayInterrupted(),
    iteratorsuccess: iterator("success"),
    iteratorfailure: iterator("failure"),
    iteratordefect: iterator("defect"),
    iteratorbreak: iterator("break"),
    iteratorreturn: iterator("return"),
    iteratorcontinue: iterator("continue"),
    iteratorInterrupted: iteratorInterrupted(),
    producersuccess: producer("success"),
    producerfailure: producer("failure"),
    producerdefect: producer("defect"),
    producerbreak: producer("break"),
    producerreturn: producer("return"),
    producercontinue: producer("continue"),
    producerInterrupted: producerInterrupted(),
    streamsuccess: stream("success"),
    streamfailure: stream("failure"),
    streamdefect: stream("defect"),
    streambreak: stream("break"),
    streamreturn: stream("return"),
    streamcontinue: stream("continue"),
    streamInterrupted: streamInterrupted(),
    concurrentsuccess: concurrent("success"),
    concurrentfailure: concurrent("failure"),
    concurrentdefect: concurrent("defect"),
    concurrentcontinue: concurrent("continue"),
    concurrentInterrupted: concurrentInterrupted(),
  }
}
