// expect-result: ["default","given","default",["given"]]
error Late { label: string }

// E names nothing a call passes. A call of late runs, so its contextual type,
// a Late, is the type of the Late it succeeds with: it says nothing about E,
// though a Late is itself an Effect that fails with a Late.
const late = <E = never>(label?: string): Late!E => new Late({ label: label ?? "default" })

function returned(): Late!! {
  return late()
}

function bound() {
  const value: Late = late("given")
  return value
}

function inArray(): Array<Late>!! {
  return [late("given")]
}

export function main() {
  const fallback: Late = late()
  return [returned().label, bound().label, fallback.label, inArray().map((e) => e.label)]
}
