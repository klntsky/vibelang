error Boom

type Run = <A>(effect: Effect.Effect<A, Boom>) => Promise<A>

export let attempts = 0
function work(): number!Boom {
  attempts++
  return 1
}

// A plain object method that only hands a program to a runner callback.
export const methodShorthand = (run: Run) => ({
  go(): Promise<number> {
    return run(work())
  }
})

// The same body as an annotated arrow property.
export const arrowProperty = (run: Run) => ({
  go: (): Promise<number> => run(work())
})

// The same body as an unannotated method.
export const unannotated = (run: Run) => ({
  go() {
    return run(work())
  }
})
