// expect-result: {"found":"Ada","missing":"No user 7","region":"eu","stats":"2 lookups"}
error UserNotFound { id: string }

service Directory {
  lookup(id: string): Effect<string | undefined>
}

service Users {
  find(id: string): Effect<string, UserNotFound>
  readonly region: string
}

service Stats {
  count(): Effect<number>
  record(): Effect<void>
}

// No setup statements: Layer.succeed.
const DirectoryLive = Layer.succeed(Directory, {
  lookup(id) {
    return id === "42" ? "Ada" : undefined
  }
})

// Setup runs once, when the layer builds: Layer.effect.
export const UsersLive = Layer.effect(Users) {
  const directory = Directory()
  const stats = Stats()
  return {
    find(id) {
      stats.record()
      const name = directory.lookup(id)
      if (name === undefined) throw new UserNotFound({ id })
      return name
    },
    region: "eu"
  }
}

const StatsLive = Layer.effect(Stats) {
  const lookups = Ref.make(0)
  return {
    count() {
      return Ref.get(lookups)
    },
    record() {
      Ref.update(lookups, (n) => n + 1)
    }
  }
}

function greet(id: string) {
  try {
    return Users.find(id)
  } catch (error) {
    return `No user ${error.id}`
  }
}

export function main() {
  return Effect.provide(() => {
    const found = greet("42")
    const missing = greet("7")
    return { found, missing, region: Users().region, stats: `${Stats.count()} lookups` }
  }, wire(UsersLive, DirectoryLive, StatsLive))
}
