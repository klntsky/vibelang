// expect-result: {"race":1,"any":2}
// await.race and await.any run each element in its own fiber, so an element
// that handles its own control operations runs (chapter 9, "Handlers and
// concurrency").
control Ask { ask(): Effect<number> }

function answered(n: number) {
  try {
    return Ask.ask()
  } handle Ask.ask() {
    resume(n)
  }
}

function late() {
  sleep("1 second")
  return 0
}

export function main() {
  return {
    race: await.race [answered(1), late()],
    any: await.any [late(), answered(2)]
  }
}
