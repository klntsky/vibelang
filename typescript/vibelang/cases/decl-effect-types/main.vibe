// expect-result: {"found":"Ada","slow":"Timeout","missing":"none","count":3,"plain":"ok"}
error NotFound { id: string }
error Timeout

// Success, errors, and no dependencies.
export function find(id: string): Effect<string, NotFound> {
  if (id === "42") return "Ada"
  throw new NotFound({ id })
}

// Dependencies left out: the body supplies them. The union is the error slot.
export function lookup(id: string): Effect<string, NotFound | Timeout, infer R> {
  if (id === "slow") throw new Timeout()
  return find(id)
}

// Neither errors nor dependencies.
export function count(): Effect<number> {
  return 3
}

// Effect types in an alias, a function type, and a parameter.
export type Finder = (id: string) => Effect<string, NotFound>
export type Scoped = Effect<string, NotFound, Scope>
export type Values = ReadonlyArray<Effect<number>>

function tryFind(f: Finder, id: string) {
  try {
    return f(id)
  } catch (error) {
    return "none"
  }
}

function describe(id: string) {
  try {
    return lookup(id)
  } catch (error) {
    return error._tag
  }
}

export function main() {
  return { found: lookup("42"), slow: describe("slow"), missing: tryFind(find, "7"), count: count(), plain: "ok" }
}
