// expect: EK2102
// A function that passes a call of itself by name reads its own E and R
// while its callees are being found. Where its contract leaves R to
// inference, that read cannot be exact, so the contract must write it.
declare const guarded: (body: Effect<number, unknown>) => Effect<number, unknown>

export function healthy(index: number): Effect<number, unknown, infer R> {
  if (index < 0) return 1
  return guarded(healthy(index - 1))
}

export function wrap(body: Effect<number, unknown>): Effect<number, unknown, infer R> {
  const layer = (index: number): Effect<number, unknown, infer R> => {
    if (index < 0) return body()
    return guarded(layer(index - 1))
  }
  return layer(3)
}

// With every channel written, the self-call is typed from the contract.
export function written(index: number): Effect<number, unknown> {
  if (index < 0) return 1
  return guarded(written(index - 1))
}
