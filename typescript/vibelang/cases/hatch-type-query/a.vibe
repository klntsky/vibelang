error Bad { cause: unknown }

// A function that throws JavaScript exceptions is TypeScript (D282).
import { parseSync } from "./parse.ts"

// A type query reads no value; the function reaches the hatch as an input.
export function viaTypeQuery(text: string) {
  return try((parse: typeof parseSync, text: string) => parse(text), (cause) => new Bad({ cause }), parseSync, text)
}

// A spelled-out function type has the same behavior.
export function viaSpelledType(text: string) {
  return try((parse: (text: string) => number, text: string) => parse(text), (cause) => new Bad({ cause }), parseSync, text)
}

const parsers = { parse: parseSync }
export function viaQualifiedQuery(text: string) {
  return try((parse: typeof parsers.parse, text: string): ReturnType<typeof parsers.parse> => parse(text), (cause) => new Bad({ cause }), parseSync, text)
}
