// expect: EK2115 EK2115 EK2115
import { Effect } from "effect"
service Needed { value(): Effect.Effect<number> }
function work() { return Effect.succeed(1) }
export function bad(): Effect.Effect<number> { log("early"); return () => 1 }
export function tail(flag: boolean): Effect.Effect<number> { if (flag) return () => 1; return work() }
export function service(): Effect.Effect<number> { Needed(); return () => 1 }
