// expect-result: [[1,2],"ab",3,[1],3,5]
// An expression body that follows a comment still answers its value: the
// lowering keeps the expression on the line of its return.
error Bad { message: string }

const later = (n: number): Effect<number> => {
  sleep("1 millis")
  return n
}

const both = (): Effect<readonly [number, number]> =>
  // Both run at once.
  Effect.all([later(1), later(2)], { concurrency: "unbounded" })

const joined = (): Effect<string> =>
  /* the parts, in order */
  Effect.map(Effect.all([later(1), later(2)]), () => "ab")

const traced = (n: number): Effect<number> =>
  // first line
  // second line
  later(n)

const parse = (text: string) =>
  // The comment sits between the arrow and its body.
  try((text) => JSON.parse(text) as unknown, (cause) => new Bad({ message: String(cause) }), text)

const step = (n: number) =>
  // A comment before a sync hatch.
  sync((n) => n + 1, n)

const stepped = (n: number) =>
  /* A block comment
     over two lines. */
  step(n)

export function main() {
  return [both(), joined(), traced(3), parse("[1]"), step(2), stepped(4)]
}
