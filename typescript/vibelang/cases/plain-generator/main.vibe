// expect-result: [1,[2,3],9,3,[4,5,6],"caught",7]
import { Effect } from "effect"

export function* steps(): Generator<number, number, unknown> {
  yield 1
  yield* [2, 3]
  return 9
}

// The McpClient coroutine shape: delegation returns the child's result.
export const depth = function*(value: unknown): Generator<void, number> {
  yield
  if (!Array.isArray(value)) return 0
  let deepest = 0
  for (const item of value) deepest = Math.max(deepest, yield* depth(item))
  return deepest + 1
}

export function* iterator(): Iterator<number> { yield 4 }
export function* iterableIterator(): IterableIterator<number> { yield 5 }
export function* iterable(): Iterable<number> { yield 6 }

export function* recover(): Generator<string, void, unknown> {
  try { yield "ready" } catch { yield "caught" }
}

export function* effectSteps(): Generator<Effect.Effect<number>, number, number> {
  return yield* Effect.succeed(7)
}

export function main() {
  Effect.succeed(undefined)
  const work = steps()
  const first = work.next().value
  const rest = [...work]
  const finished = steps()
  finished.next()
  finished.next()
  finished.next()
  const done = finished.next().value
  const tree = depth([[1], [[2]]])
  let result: IteratorResult<void, number> = tree.next()
  while (!result.done) result = tree.next()
  const values = [iterator().next().value, ...iterableIterator(), ...iterable()]
  const recovery = recover()
  recovery.next()
  return [first, rest, done, result.value, values, recovery.throw(new Error("step")).value, Effect.gen(effectSteps)]
}
