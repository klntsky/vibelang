// expect: EK2003 EK2001
error Bad {}
// A local arrow that runs an Effect still lifts its caller.
export const invalid = (): number => {
  const check = () => Effect.succeed(1)
  return check()
}
// Its own explicit Effect contract overrides the surrounding plain contract.
export const builds = (): () => Effect.Effect<number, never, never> => {
  const check = (): Effect.Effect<number, never, never> => { throw new Bad() }
  return check
}
