import * as Context from "effect/Context"
import * as Effect from "effect/Effect"

const Tag = Context.Reference<number>("S10-2/Tag", { defaultValue: () => 0 })
type Wrap = (body: Effect.Effect<number, never, never>) => Effect.Effect<number, never, never>

// Both branches produce the program that provision must run.
export const bare = (wrap: Wrap | undefined): Effect.Effect<unknown, never, never> => {
  const body: Effect.Effect<number, never, never> = () => 41 + Tag()
  return Effect.provideService(wrap === undefined ? body : wrap(body), Tag, 1)
}

// Control: calling the held program in its arm runs it.
export const called = (wrap: Wrap | undefined): Effect.Effect<unknown, never, never> => {
  const body: Effect.Effect<number, never, never> = () => 41 + Tag()
  return Effect.provideService(wrap === undefined ? body() : wrap(body), Tag, 1)
}

export function orChoice(body: Effect.Effect<number> | undefined, wrap: Wrap): Effect.Effect<number> {
  return Effect.provideService(body || wrap(() => 41 + Tag()), Tag, 1)
}

export function nullishChoice(body: Effect.Effect<number> | undefined, wrap: Wrap): Effect.Effect<number> {
  return Effect.provideService(body ?? wrap(() => 41 + Tag()), Tag, 1)
}

export function commaChoice(wrap: Wrap): Effect.Effect<number> {
  const body: Effect.Effect<number> = () => 41 + Tag()
  return Effect.provideService((Effect.sleep("1 millis"), wrap(body)), Tag, 1)
}

export function withCondition(wrap: Wrap): Effect.Effect<number> {
  const body: Effect.Effect<number> = () => 41 + Tag()
  return Effect.provideService(Effect.succeed(true) ? body : wrap(body), Tag, 1)
}

export function withPipe(wrap: Wrap | undefined): Effect.Effect<number> {
  const body: Effect.Effect<number> = () => 41 + Tag()
  return (wrap === undefined ? body : wrap(body)) |> Effect.provideService(%, Tag, 1)
}

function pureNumber() { return 42 }

export function plainFallback(body: Effect.Effect<number> | undefined): Effect.Effect<number> {
  return Effect.uninterruptible(body ?? pureNumber())
}

export function plainConditional(choose: boolean): Effect.Effect<number> {
  const body: Effect.Effect<number> = () => 42
  return Effect.uninterruptible(choose ? body : pureNumber())
}
