// expect-result: [true,true,true,true]
// The spelling EK4802's quick fix writes for a returned arm: a called Effect
// value runs, so emit(0) interrupts and emit(1) logs.
interface Hooks {
  emit: (n: number) => Effect<void>
  cached: (n: number | undefined) => Effect<void>
}

const hooks: Hooks = {
  emit: (n) => n === 0 ? Effect.interrupt() : Console.log("emit", n),
  cached: (n) => n ?? Effect.interrupt(),
}

export function main() {
  return [
    Exit.isFailure(exit(hooks.emit(0))),
    Exit.isSuccess(exit(hooks.emit(1))),
    Exit.isFailure(exit(hooks.cached(undefined))),
    Exit.isSuccess(exit(hooks.cached(2))),
  ]
}
