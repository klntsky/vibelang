// expect: EK4201
// Effect's forks, races, and timeouts run a program on another fiber, which
// cannot reach a handler on this one (chapter 9, "Handlers and
// concurrency"). A call passed by name (D147) is checked as the lambda
// () => call would be, including a pipe's left side.
control Ask { ask(): number!! }

export function forked() {
  try {
    const f = Effect.forkChild(Ask.ask())
    return Fiber.join(f)
  } handle Ask.ask() {
    resume(1)
  }
}

export function detached() {
  try {
    const f = Effect.forkDetach(Ask.ask())
    return Fiber.join(f)
  } handle Ask.ask() {
    resume(1)
  }
}

export function piped() {
  try {
    const f = Ask.ask() |> Effect.forkChild(%)
    return Fiber.join(f)
  } handle Ask.ask() {
    resume(1)
  }
}

export function timed() {
  try {
    return Effect.timeout(Ask.ask(), "1 second")
  } handle Ask.ask() {
    resume(1)
  }
}

export function raced() {
  try {
    return Effect.race(Ask.ask(), sleep("1 second"))
  } handle Ask.ask() {
    resume(1)
  }
}

export function keyed() {
  try {
    return Effect.all({ x: Ask.ask(), y: sleep("1 second") }, { concurrency: 2 })
  } handle Ask.ask() {
    resume(1)
  }
}

// retry runs its program on this fiber, so the handler is reached.
export function retried() {
  try {
    return retry(Ask.ask(), { times: 1 })
  } handle Ask.ask() {
    resume(1)
  }
}
