// expect-result: ["ok",42,"ok",42,1,"refused",6]
import { Effect } from "effect"
import { choose, bootstrap, counts } from "./callbacks.js"

export function direct(flag: boolean) {
  const value = choose(flag)
  return value
}
export function byName(flag: boolean) {
  return Effect.map(choose(flag), (value) => value)
}
function readCounts(): number { return counts() }
export function main() {
  const a = direct(true)
  const b = direct(false)
  const c = byName(true)
  const d = byName(false)
  const args = bootstrap(false)
  let failure = "missing"
  try { bootstrap(true) } catch (error) { failure = error }
  choose(true)
  return [a, b, c, d, args.length, failure, readCounts()]
}
