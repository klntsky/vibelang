// expect-result: {"masked":true,"released":true,"restored":"Failure","returned":"lease"}

// An uninterruptible block that owns a using resource finishes when its fiber
// is interrupted, and releases the resource when the block ends.
function masked() {
  const done = Deferred.make<string>()
  const released = Deferred.make<boolean>()
  const fiber = fork {
    uninterruptible {
      using lease = Effect.acquireRelease(Effect.succeed("lease"), () => Deferred.succeed(released, true))
      sleep("20 millis")
      Deferred.succeed(done, lease)
    }
  }
  sleep("5 millis")
  fiber.interrupt()
  return { masked: Deferred.isDone(done), released: Deferred.isDone(released) }
}

// restore inside such a block brings back the interruptibility the block began with.
function restored() {
  const started = Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      using lease = Effect.acquireRelease(Effect.succeed("lease"), () => Effect.void)
      restore {
        Deferred.succeed(started, lease)
        sleep("1 second")
      }
    }
  }
  started.await()
  fiber.interrupt()
  return exit(fiber.join())._tag
}

// A return inside the block returns from the function, after the release.
function returned() {
  uninterruptible {
    using lease = Effect.acquireRelease(Effect.succeed("lease"), () => Effect.void)
    return lease
  }
}

export function main() {
  return { ...masked(), restored: restored(), returned: returned() }
}
