// expect-result: {"typed":"NotFound","defect":"Die","rethrown":"Boom","onlyCause":"Fail","untyped":"Expected"}
error NotFound { id: string }
error Boom

function find(id: string): Effect<string, NotFound> {
  if (id === "missing") throw new NotFound({ id })
  if (id === "bug") die(new Error("bug"))
  return id
}

function boom() {
  throw new Boom()
}

// Catch expected failures inside exit; defects remain in its Failure case.
function typed() {
  const outcome = exit(do {
    try { find("missing") } catch (e) { e._tag }
  })
  if (outcome._tag === "Success") return outcome.value
  return "cause"
}

function defect() {
  const outcome = exit(find("bug"))
  if (outcome._tag === "Success") return outcome.value
  return outcome.cause.reasons[0]._tag
}

function rethrown() {
  try {
    const outcome = exit(boom())
    if (outcome._tag === "Failure") Effect.failCause(outcome.cause)
    return "no"
  } catch (e) {
    return e._tag
  }
}

function onlyCause() {
  const outcome = exit(boom())
  if (outcome._tag === "Success") return "no"
  return outcome.cause.reasons[0]._tag
}

function untyped() {
  const outcome = exit(do {
    try { boom(); "no" } catch (e) { "Expected" }
  })
  if (outcome._tag === "Success") return outcome.value
  return "cause"
}

export function main() {
  return { typed: typed(), defect: defect(), rethrown: rethrown(), onlyCause: onlyCause(), untyped: untyped() }
}
