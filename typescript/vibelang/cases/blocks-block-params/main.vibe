// expect-result: {"spanned":"ADA","timed":"in time","guarded":"guarded","appended":42,"method":"job:done","bare":"once","nested":"outer:inner"}
function getName(): Effect<string> {
  return "Ada"
}

// A data-last Effect function takes the block as its program.
function spanned() {
  return withSpan("load") {
    const name = getName()
    return name.toUpperCase()
  }
}

function timed() {
  return timeout("1 second") {
    sleep("1 millis")
    return "in time"
  }
}

function guarded() {
  const semaphore = Semaphore.make(1)
  return semaphore.withPermits(1) {
    return "guarded"
  }
}

// A function that takes the program as its last argument gets the block there.
function twice(label: string, program: () => Effect<number>) {
  return label.length + program() + program()
}

function appended() {
  return twice("abcd") {
    return 19
  }
}

class Runner {
  run(name: string, program: () => Effect<string>) {
    return `${name}:${program()}`
  }
}

function method() {
  const runner = new Runner()
  return runner.run("job") {
    return "done"
  }
}

// A name followed by a block passes the block as the only argument.
function once(program: () => Effect<string>) {
  return program()
}

function bare() {
  return once {
    return "once"
  }
}

function nested() {
  return runnerOf().run("outer") {
    return once { return "inner" }
  }
}

function runnerOf() {
  return new Runner()
}

export function main() {
  return { spanned: spanned(), timed: timed(), guarded: guarded(), appended: appended(), method: method(), bare: bare(), nested: nested() }
}
