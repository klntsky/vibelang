// expect-result: [10,20,30,40,50,60,70]
import { Context, Effect, Stream } from "effect"
export const Timings = Context.Reference<(timing: number) => Effect.Effect<void>>("probe/Timings", {
  defaultValue: () => () => {}
})
function report(timing: number) {
  const hear = Timings()
  hear(timing)
  return timing
}
export function main() {
  let reported = 0
  Effect.provideService(report(10), Timings, (heard) => { reported = heard })
  const bare = reported
  Effect.provideService(report(20), Timings, (heard): Effect.Effect<void> => { reported = heard })
  const annotated = reported
  Effect.provideService(Timings, (heard) => { reported = heard })(() => report(30))
  const curried = reported
  Stream.runCollect(Stream.provideService(Stream.fromEffect(report(40)), Timings, (heard) => { reported = heard }))
  const stream = reported
  Stream.runCollect(Stream.provideService(Stream.fromEffect(report(50)), Timings, (heard): Effect.Effect<void> => { reported = heard }))
  const streamAnnotated = reported
  provide Timings = (heard) => { reported = heard } { report(60) }
  const block = reported
  provide Timings = (heard): Effect.Effect<void> => { reported = heard } { report(70) }
  return [bare, annotated, curried, stream, streamAnnotated, block, reported]
}
