// expect: TS2322 EK2001
import * as Effect from "effect/Effect"
import * as Exit from "effect/Exit"
export function wrongSuccess(): Effect.Effect<number> {
  return Effect.orDie(Effect.succeed(Exit.succeed(1)) |> (Effect.tap(%, () => Effect.sleep("1 millis"))))
}
export function wrongFailure(): Effect.Effect<Exit.Exit<number, never>> {
  return Effect.map(Effect.fail("bad") |> Effect.tap(%, () => Effect.sleep("1 millis")), () => Exit.succeed(1))
}
