// expect-result: [["a","b","c"],null]
import { Effect } from "effect"

const find = (
  target: string,
  start: string,
  parentsOf: (id: string) => Effect.Effect<ReadonlyArray<string>, never, never>
): Effect.Effect<ReadonlyArray<string> | undefined, never, never> =>
  Effect.suspend(() => {
    const walk = (
      current: string,
      chain: ReadonlyArray<string>
    ): Effect.Effect<ReadonlyArray<string> | undefined, never, never> => {
      const parents = parentsOf(current)
      for (const parent of parents) {
        if (parent === target) return [...chain, parent]
        const found = walk(parent, [...chain, parent])
        if (found !== undefined) return found
      }
      return undefined
    }
    return walk(start, [start])
  })

export function main() {
  const parentsOf = (id: string): Effect.Effect<ReadonlyArray<string>, never, never> =>
    Effect.succeed(id === "a" ? ["b"] : id === "b" ? ["c"] : [])
  return [find("c", "a", parentsOf), find("missing", "a", parentsOf)]
}
