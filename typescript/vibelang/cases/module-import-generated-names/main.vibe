// A module declaration's import moves to the file's top level under a
// generated name, effect/Effect's as Effect_1 when the file uses Effect. The
// names the lowering generates for its own imports differ from it: the
// lowering's Effect import was named Effect_1 too, and loading the file
// failed with "Identifier 'Effect_1' has already been declared".
module helpers {
  import * as Effect from "effect/Effect"

  export const twice = <A>(effect: Effect.Effect<A>): Effect.Effect<[A, A]> => Effect.all([effect, effect])
}

import { twice } from helpers

export const pair = () => twice(Effect.succeed(1))

// expect-result: [1,1]
export function main() {
  return pair()
}
