import { write, publish, operand, transaction, writeValue, twice, make } from "./probe.js"

// Explicit function signatures expose program positions to both compilers.
const repeat: (program: Effect.Effect<number>) => Effect.Effect<number[]> = twice

export function commitThenPublish(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(write())
    publish()
  })
}

export function withOperand(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(write(operand()))
    publish()
  })
}

export function withTopic(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    write() |> restore(%)
    publish()
  })
}

export function withValue(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(writeValue())
    publish()
  })
}

export function withOptional(): Effect<void> {
  const writer: { write?: typeof write } = { write }
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(writer.write?.())
    publish()
  })
}

export function withTag(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(transaction`commit`)
    publish()
  })
}

export function withThis(this: { write: typeof write }): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(this.write())
    publish()
  })
}

export function withMethod(): Effect<void> {
  Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    restore(writeValue.interruptible())
    publish()
  })
}

export function lazyTwice() {
  return repeat(make())
}
