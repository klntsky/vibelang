// expect-result: {"described":["Ada","missing 0"],"both":["missing","slow"],"any":"failed Timeout","nested":"to","tagged":"by tag","plain":"plain"}
// Effect's catch combinators draw EK4835 (D289); the fix writes a catch
// expression with one arm per tag. An arm names the error class when the
// class's declaration fixes the tag, and tests _tag otherwise, as catchTag
// does. tsforms-catch-fixed is what vibelang --fix writes.
error Missing { id: number }
error Timeout

class Tagged {
  readonly _tag = "Tagged" as const
}

function find(id: number): Effect<string, Missing | Timeout, infer R> {
  if (id === 0) throw new Missing({ id })
  if (id < 0) throw new Timeout()
  return "Ada"
}

function tagged(): Effect<string, Tagged, infer R> {
  throw new Tagged()
}

function describe(id: number) {
  return find(id) catch (e) => match (e) { when Missing: `missing ${e.id}`; default: throw e; }
}

function both(id: number) {
  return find(id) catch (e) => match (e) { when Missing: "missing"; when Timeout: "slow"; default: throw e; }
}

function any(id: number) {
  return find(id) catch (e) => `failed ${e._tag}`
}

function nested(id: number) {
  return (find(id) catch (e) => match (e) { when Missing: "nf"; default: throw e; }) catch (e) => match (e) {
    when Timeout: "to";
    default: throw e;
  }
}

export function main() {
  return {
    described: [describe(1), describe(0)],
    both: [both(0), both(-1)],
    any: any(-1),
    nested: nested(-1),
    tagged: tagged() catch (e) => match (e) { when { _tag: "Tagged" }: "by tag"; default: throw e; },
    plain: find(-1) catch "plain"
  }
}
