{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out",
    "vibelang": { "diagnostics": { "EK2004": "off", "EK4403": "warning" }, "tracing": "exported" }
  },
  "include": ["*.vibe", "*.ts"]
}
