// expect-result: {"full":"Ada","noDependencies":1,"inferred":"Ada","neither":3,"onlyDependencies":2,"arrow":2,"find":"none","either":4,"unwrap":5}
// D308: the ! form of an Effect type is retired, and each one is EK1014.
// retired-effect-types.fail writes every form; retired-effect-types-fixed is
// what vibelang --fix writes for it, which compiles and runs. A ! form
// without dependencies infers them on a function with a body, so the fix
// writes infer R there and nothing elsewhere.
error NotFound { id: string }
error Timeout

service Users {
  find(id: string): Effect<string, NotFound>
  count(): Effect<number>
}

const UsersLive = Layer.succeed(Users, {
  find(id: string) {
    if (id !== "42") throw new NotFound({ id })
    return "Ada"
  },
  count() {
    return 2
  }
})

function full(id: string): Effect<string, NotFound, Users> {
  return Users.find(id)
}

function noDependencies(n: number): Effect<number, Timeout> {
  if (n < 0) throw new Timeout()
  return n
}

function inferred(id: string): Effect<string, NotFound, infer R> {
  return Users.find(id)
}

function neither(): Effect<number> {
  return 3
}

function onlyDependencies(): Effect<number, never, Users> {
  return Users.count()
}

const arrow = (n: number): Effect<number, Timeout, infer R> => noDependencies(n) + 1

type Finder = (id: string) => Effect<string, NotFound>
type Maybe = Effect<number> | undefined
type Nested = Effect<Effect<number>, NotFound>

function find(finder: Finder, id: string): Effect<string> {
  return finder(id) catch "none"
}

function either(program: Maybe): Effect<number> {
  return program === undefined ? 0 : program()
}

const five: Effect<number> = Effect.sync(() => 5)

function unwrap(program: Nested): Effect<number, NotFound> {
  const inner = program()
  return inner()
}

export function main() {
  provide UsersLive {
    return {
      full: full("42"),
      noDependencies: noDependencies(1),
      inferred: inferred("42"),
      neither: neither(),
      onlyDependencies: onlyDependencies(),
      arrow: arrow(1),
      find: find((id) => { if (id === "7") throw new NotFound({ id }); return id }, "7"),
      either: either(Effect.succeed(4)),
      unwrap: unwrap(Effect.succeed(five))
    }
  }
}
