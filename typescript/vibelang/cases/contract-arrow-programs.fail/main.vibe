// expect: TS2345 TS2322 EK2001
import { Effect } from "effect"
error Bad { reason: string }
function wrap(effect: Effect.Effect<number, Bad, never>) { return effect() }
export function main() {
  wrap((value: number): Effect.Effect<number, Bad, infer R> => { return value })
  wrap((): Effect.Effect<string, Bad, infer R> => "wrong")
  wrap((): Effect.Effect<number, Bad, infer R> => "wrong")
  wrap((): Effect.Effect<number, Bad, infer R> => { throw "wrong" })
}
