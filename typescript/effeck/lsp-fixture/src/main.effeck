import { Console, Data, Effect } from "effect"
import { findName, names } from "./users.js"

class NotFound extends Data.TaggedError("NotFound")<{ readonly id: number }> {}

// No annotations: the compiler infers Effect<string, NotFound, never>.
function lookup(id: number) {
  if (id >= names.length) Effect.fail(new NotFound({ id }))
  return findName(id)
}

export function main() {
  const name = lookup(1)
  Console.log(`found ${name.toUpperCase()}`)
}

function greeting() {
  Effect.sleep("1 millis")
  return "hello"
}

// Effect.timeout receives the greeting call by name, as a program (D147).
export function eventually() {
  return Effect.timeout(greeting(), "1 second")
}

// Method syntax on an Effect data type (D152).
export function labelled(id: number) {
  return Option.some(id).map((n) => `#${n}`).getOrElse(() => "none")
}

// The pipe operator (D154, D155): Effect.timeout receives greeting() by name
// through the first topic; the second topic is the timed greeting's value.
export function piped() {
  return greeting() |> Effect.timeout(%, "1 second") |> `${%}!`
}
