export error MissingUser { id: string }

export function findUser(id: string): string!MissingUser! {
  if (id === "") throw new MissingUser({ id })
  return id
}

export service Accounts {
  balance(id: string): number!MissingUser
}

export function total(id: string) {
  return Accounts.balance(id)
}

export layer AccountsLive: Accounts {
  const rate = 2
  balance(id) {
    return id.length * rate
  }
}
