// Reference program 4. Callbacks: a pure Array.map; a rejected callback that pauses
// (ch10-map-pausing-callback.fail.effeck and ref4-pausing-function-value.fail.effeck); an effect-aware
// traversal; a callback API adapted with suspend under cancellation (ref4-adapter.ts).
// NOTE: the proposal states this program in prose only; the contract comments below are this file's
// expectations, not contracts printed in the proposal.
import { connect, log, type FakeSocket } from "./ref4-adapter.ts"

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

function double(n: number) {
  return n * 2
}

// A pure Array.map: a plain callback, and a pure .effeck function passed by name (D9: its plain variant).
function pureMaps(ids: ReadonlyArray<string>, xs: ReadonlyArray<number>) {
  const trimmed = ids.map((id) => id.trim())
  const doubled = xs.map(double)
  return { trimmed, doubled }
}

// Effect-aware traversals: Effect.forEach takes callbacks that return Effects; so does a for...of loop.
function names(ids: ReadonlyArray<string>) {
  return Effect.forEach(ids, (id) => Users.find(id).name)
}
// Effect<string[], UserNotFound, Users>

function namesLoop(ids: ReadonlyArray<string>) {
  const out: string[] = []
  for (const id of ids) out.push(Users.find(id).name)
  return out
}
// Effect<string[], UserNotFound, Users>

// The adapted callback API under `using`; a timeout cancels a slow connection.
function handshake(socket: FakeSocket) {
  return `hello ${socket.url}`
}

function session(url: string, delayMs: number) {
  using socket = connect(url, delayMs)
  return handshake(socket)
}

const UsersTest = Layer.succeed(Users, {
  find: (id) => ({ id, name: `user-${id}` })
})

function scenario() {
  const maps = pureMaps([" a", "b "], [1, 2, 3])
  const viaForEach = names(["1", "2"])
  const viaLoop = namesLoop(["2", "1"])
  const fast = session("tcp://fast", 1)
  let slow = "none"
  try {
    Effect.timeout(() => session("tcp://slow", 50), "5 millis")
  } catch (e) {
    slow = e._tag
  }
  return { trimmed: maps.trimmed, doubled: maps.doubled, viaForEach, viaLoop, fast, slow, log }
}

// expect-result: {"trimmed":["a","b"],"doubled":[2,4,6],"viaForEach":["user-1","user-2"],"viaLoop":["user-2","user-1"],"fast":"hello tcp://fast","slow":"TimeoutError","log":["dial tcp://fast","destroy tcp://fast","dial tcp://slow","destroy tcp://slow"]}
export function main() {
  return Effect.provide(() => scenario(), UsersTest)
}
