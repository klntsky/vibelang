{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "outDir": "out",
    "effeck": {
      "diagnostics": {
        "EK4803": "error"
      }
    }
  },
  "include": [
    "*.effeck"
  ]
}
