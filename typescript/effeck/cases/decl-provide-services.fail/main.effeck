// expect: TS2769 TS2769
// A provider written Key = value needs a service key, or a module whose
// export of the same name is one, and a value of that service's shape (D173).
service class Greeting {
  text(): string!!
}

const answer = 42

function notAKey() {
  provide answer = 1 {
    return 0
  }
}

function wrongShape() {
  provide Greeting = { words: 1 } {
    return Greeting.text()
  }
}

export function main() {
  return [notAKey(), wrongShape()]
}
