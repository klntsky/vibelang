// expect: EK4402
// Chapter 10 "Promises", verbatim. fetch is a platform API, which D5 makes uncallable from .effeck
// files; D6 points at HttpClient instead.

class HttpError extends TaggedError("HttpError")<{ readonly url: string; readonly cause: unknown }> {}

function fetchJson(url: string) {
  const response = Effect.tryPromise({
    try: (signal) => fetch(url, { signal }),
    catch: (cause) => new HttpError({ url, cause })
  })
  return Effect.tryPromise({
    try: () => response.json(),
    catch: (cause) => new HttpError({ url, cause })
  })
}
// Effect<any, HttpError, never>: Response.json() returns Promise<any>
