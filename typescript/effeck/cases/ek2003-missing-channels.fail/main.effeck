// expect: EK2003
// Leaving a channel out of a contract does not say whether it is never or
// inferred (D57).
class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

export function find(id: string): Effect<string> {
  return id
}

export function lookup(id: string): Effect<string, UserNotFound> {
  if (id === "") throw new UserNotFound({ id })
  return id
}
