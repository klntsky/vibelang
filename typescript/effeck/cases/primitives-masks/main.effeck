// expect-result: {"masked":"done","restored":"Failure","forced":"Failure","returned":7,"call":"work"}

// An uninterruptible block finishes even when its fiber is interrupted.
function masked() {
  const done = Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      sleep("20 millis")
      Deferred.succeed(done, "done")
    }
  }
  sleep("5 millis")
  fiber.interrupt()
  return await done
}

// restore brings back the interruptibility the block began with.
function restored() {
  const started = Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      restore {
        Deferred.succeed(started, "started")
        sleep("1 second")
      }
    }
  }
  await started
  fiber.interrupt()
  return exit(fiber.join())._tag
}

// interruptible makes code interruptible inside an uninterruptible block.
function forced() {
  const started = Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      interruptible {
        Deferred.succeed(started, "started")
        sleep("1 second")
      }
    }
  }
  await started
  fiber.interrupt()
  return exit(fiber.join())._tag
}

// A return inside the block returns from the function.
function returned() {
  uninterruptible {
    return 7
  }
}

function work() {
  return "work"
}

// The call form runs a program the same way.
function call() {
  return uninterruptible(work())
}

export function main() {
  return { masked: masked(), restored: restored(), forced: forced(), returned: returned(), call: call() }
}
