// Chapter 10. Working with TypeScript.
import {
  Database,
  DatabaseTest,
  DbError,
  fetchGreeting,
  findUser,
  formatName,
  loadAvatar,
  parsePort,
  parsePortTrusted,
  StorageTest,
  UserNotFound,
  type User
} from "./ch10-helpers.ts"

class ConfigError extends TaggedError("ConfigError")<{ readonly cause: unknown }> {}
class HttpError extends TaggedError("HttpError")<{ readonly url: string; readonly cause: unknown }> {}

interface Config {
  readonly port: number
}

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

// Using TypeScript Effect code from Effeck

export function title(id: string) {
  return findUser(id).name.toUpperCase()
}
// Effect<string, UserNotFound | DbError, Database>

// Services written as Context.Service classes in TypeScript are used like .effeck services.
function rowCount(id: string) {
  return Database.query("select * from users where id = $1", [id]).length
}

// Generator-style code stays in TypeScript: see ch10-effect-gen.fail.effeck (EK1002).

// Plain functions

function parseConfig(text: string) {
  return Effect.try({
    try: () => JSON.parse(text) as Config,
    catch: (cause) => new ConfigError({ cause })
  })
}
// Effect<Config, ConfigError, never>

// Chapter 2's profileCard. NOTE: D5 makes the proposal's bare `formatName(user)` an error (EK4401,
// see ch02-plain-ts-call.fail.effeck), so the plain call is wrapped in Effect.try; the claim below is the
// proposal's, from before D5.
function profileCard(id: string) {
  const user = Users.find(id)
  return {
    title: Effect.try(() => formatName(user)),   // a plain call behind a boundary
    avatar: loadAvatar(user.id)                  // returns an Effect, so the call runs it
  }
}
// Effect<{ title: string; avatar: Avatar }, UserNotFound | AvatarError, Users | Storage>

// A throwing plain function behind a boundary, with the typed failure caught.
function portOrDefault(text: string) {
  try {
    return Effect.try({ try: () => parsePort(text), catch: (cause) => new ConfigError({ cause }) })
  } catch (e) {
    return 80
  }
}

// D23: a plain TypeScript function with a trusted contract (a JSDoc tag) is called bare; its
// @throws class joins E. NOTE: the contract comment is this file's expectation, not the proposal's.
function portFrom(text: string) {
  return parsePortTrusted(text)
}
// Effect<number, PortError, never>

// Promises
// NOTE: the proposal calls fetch, a platform API (D5: EK4402, see ch10-fetch.fail.effeck); a local
// Promise-returning helper stands in for it.
function fetchJson(url: string) {
  const response = Effect.tryPromise({
    try: () => fetchGreeting(url),
    catch: (cause) => new HttpError({ url, cause })
  })
  return response.greeting
}

// Callbacks into plain JavaScript (the rejected callback is ch10-map-pausing-callback.fail.effeck)

function trimAll(ids: ReadonlyArray<string>) {
  const trimmed = ids.map((id) => id.trim())         // fine
  return trimmed
}

const UsersTest = Layer.succeed(Users, {
  find: (id) => ({ id, name: "Ada", email: "ada@example.com" })
})

function scenario() {
  const upper = title("1")
  let missing = "none"
  try {
    title("2")
  } catch (e) {
    missing = e._tag
  }
  const rows = rowCount("1")
  const config = parseConfig(`{"port":8080}`)
  let badConfig = "none"
  try {
    parseConfig("{")
  } catch (e) {
    badConfig = e._tag
  }
  const card = profileCard("1")
  const defaultPort = portOrDefault("x")
  const trustedPort = portFrom("9090")
  let badPort = "none"
  try {
    portFrom("x")
  } catch (e) {
    badPort = e._tag
  }
  const greeting = fetchJson("ada")
  const trimmed = trimAll([" a ", "b "])
  return { upper, missing, rows, port: config.port, badConfig, card, defaultPort, trustedPort, badPort, greeting, trimmed }
}

// expect-result: {"upper":"ADA","missing":"UserNotFound","rows":1,"port":8080,"badConfig":"ConfigError","card":{"title":"Ada <ada@example.com>","avatar":{"userId":"1","url":"https://img.example.com/1.png"}},"defaultPort":80,"trustedPort":9090,"badPort":"PortError","greeting":"hello ada","trimmed":["a","b"]}
export function main() {
  return Effect.provide(() => scenario(), Layer.mergeAll(DatabaseTest, StorageTest, UsersTest))
}
