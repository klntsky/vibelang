// effeck --sourceMap maps generated JavaScript to .effeck lines (D36), inside
// lowered generators and region closures, and each generator is named after
// its source, so a stack trace names the Effeck function.
class NotFound extends TaggedError("NotFound")<{ readonly id: number }> {}

interface Account {
  readonly owner: { readonly name: string } | undefined
}

function ownerName(account: Account) {
  Effect.yieldNow()
  return account.owner!.name
}

function lookup(id: number) {
  Effect.yieldNow()
  throw new NotFound({ id })
}

function audited(account: Account) {
  try {
    Effect.yieldNow()
    return account.owner!.name.length
  } finally {
    Effect.yieldNow()
  }
}

// A recursive function refers to itself, so its generator is an object
// literal's method, which binds no name: countdown(n - 1, seen) still calls
// the Effect function.
function countdown(n: number, seen: number[]) {
  Effect.yieldNow()
  seen.push(n)
  if (n > 0) countdown(n - 1, seen)
  return seen
}

export function crash() {
  return ownerName({ owner: undefined })
}

export function missing() {
  return lookup(7)
}

export function region() {
  return audited({ owner: undefined })
}

export function counted() {
  return countdown(3, [])
}
