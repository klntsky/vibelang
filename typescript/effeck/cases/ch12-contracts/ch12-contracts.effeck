// Chapter 12. Contracts and inference.

class CartNotFound extends TaggedError("CartNotFound")<{ readonly cartId: string }> {}
class EmptyCart extends TaggedError("EmptyCart")<{ readonly cartId: string }> {}
class PricingDown extends TaggedError("PricingDown")<{ readonly reason: string }> {}
class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}
class MailError extends TaggedError("MailError")<{ readonly reason: string }> {}
class IOError extends TaggedError("IOError")<{ readonly path: string }> {}

interface Item {
  readonly sku: string
  readonly price: number
}

interface Cart {
  readonly id: string
  readonly items: ReadonlyArray<Item>
}

interface Quote {
  readonly total: number
  readonly estimated: boolean
}

interface User {
  readonly id: string
  readonly name: string
  readonly email: string
}

interface Entry {
  readonly isDirectory: boolean
  readonly size: number
}

abstract class Carts {
  abstract load(cartId: string): Effect<Cart, CartNotFound, never>
}

abstract class Pricing {
  abstract quote(cart: Cart): Effect<Quote, PricingDown, never>
}

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

abstract class Mailer {
  abstract send(to: string, body: string): Effect<void, MailError, never>
}

abstract class Files {
  abstract stat(path: string): Effect<Entry, IOError, never>
  abstract list(path: string): Effect<ReadonlyArray<string>, IOError, never>
}

// What the compiler infers
// NOTE: the proposal calls estimate "a plain function"; under D5 it is a pure .effeck helper.

function estimate(cart: Cart) {
  let total = 0
  for (const item of cart.items) total += item.price
  const quote: Quote = { total, estimated: true }
  return quote
}

function quoteCart(cartId: string) {
  const cart = Carts.load(cartId)              // E: CartNotFound   R: Carts
  if (cart.items.length === 0) throw new EmptyCart({ cartId })
  try {
    return Pricing.quote(cart)                 // E: PricingDown    R: Pricing
  } catch (e) {                                // e: PricingDown
    return estimate(cart)                      // a plain function
  }
}
// Effect<Quote, CartNotFound | EmptyCart, Carts | Pricing>

// Checking a written contract
// NOTE: the proposal's example omits Mailer from R to show EK2002 (ch12-welcome-missing-mailer.fail.effeck);
// this version states the full contract, which must check.

export function welcome(id: string): Effect<string, UserNotFound | MailError, Users | Mailer> {
  const user = Users.find(id)
  Mailer.send(user.email, "Welcome")
  return user.name
}

// Declarations without bodies: see ch12-rates-bare-return.fail.effeck (EK2101).

// Recursion

function totalSize(path: string) {
  const entry = Files.stat(path)
  if (!entry.isDirectory) return entry.size
  let total = 0
  for (const child of Files.list(path)) total += totalSize(`${path}/${child}`)
  return total
}
// Effect<number, IOError, Files>

const carts = new Map<string, Cart>([
  ["full", { id: "full", items: [{ sku: "a", price: 3 }, { sku: "b", price: 4 }] }],
  ["empty", { id: "empty", items: [] }],
  ["down", { id: "down", items: [{ sku: "c", price: 5 }] }]
])

const CartsTest = Layer.succeed(Carts, {
  load: (cartId) => {
    const cart = carts.get(cartId)
    if (cart === undefined) throw new CartNotFound({ cartId })
    return cart
  }
})

const PricingTest = Layer.succeed(Pricing, {
  quote: (cart) => {
    if (cart.id === "down") throw new PricingDown({ reason: "maintenance" })
    let total = 0
    for (const item of cart.items) total += item.price * 2
    const quote: Quote = { total, estimated: false }
    return quote
  }
})

const UsersTest = Layer.succeed(Users, {
  find: (id) => ({ id, name: "Ada", email: "ada@example.com" })
})

const outbox: string[] = []

const MailerTest = Layer.succeed(Mailer, {
  send: (to, body) => {
    outbox.push(`${to}: ${body}`)
  }
})

const tree = new Map<string, Entry>([
  ["/root", { isDirectory: true, size: 0 }],
  ["/root/a.txt", { isDirectory: false, size: 10 }],
  ["/root/sub", { isDirectory: true, size: 0 }],
  ["/root/sub/b.txt", { isDirectory: false, size: 20 }],
  ["/root/sub/c.txt", { isDirectory: false, size: 12 }]
])

const children = new Map<string, ReadonlyArray<string>>([
  ["/root", ["a.txt", "sub"]],
  ["/root/sub", ["b.txt", "c.txt"]]
])

const FilesTest = Layer.succeed(Files, {
  stat: (path) => {
    const entry = tree.get(path)
    if (entry === undefined) throw new IOError({ path })
    return entry
  },
  list: (path) => children.get(path) ?? []
})

function scenario() {
  const full = quoteCart("full")
  const down = quoteCart("down")
  let empty = "none"
  try {
    quoteCart("empty")
  } catch (e) {
    empty = e._tag
  }
  let missing = "none"
  try {
    quoteCart("nope")
  } catch (e) {
    missing = e._tag
  }
  const name = welcome("1")
  const size = totalSize("/root")
  return { full, down, empty, missing, name, size, outbox }
}

// expect-result: {"full":{"total":14,"estimated":false},"down":{"total":5,"estimated":true},"empty":"EmptyCart","missing":"CartNotFound","name":"Ada","size":42,"outbox":["ada@example.com: Welcome"]}
export function main() {
  return Effect.provide(() => scenario(), Layer.mergeAll(CartsTest, PricingTest, UsersTest, MailerTest, FilesTest))
}
