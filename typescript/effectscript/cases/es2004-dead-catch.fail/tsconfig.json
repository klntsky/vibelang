{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out",
    "effectscript": { "diagnostics": { "ES2004": "error" } }
  },
  "include": ["*.es"]
}
