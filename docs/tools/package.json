{
  "name": "vibelang-docs-tools",
  "private": true,
  "type": "module",
  "description": "Builds the docs site from docs/user/src and the specification chapters in docs/design/src, and checks the user docs' code blocks.",
  "scripts": {
    "build": "bun render-user.ts",
    "check:snippets": "bun check-snippets.ts",
    "check:content": "bun check-smithers-content.ts"
  },
  "devDependencies": {
    "marked": "18.0.12",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "vitest": "5.0.5",
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5"
  }
}
