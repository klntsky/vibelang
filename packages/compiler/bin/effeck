#!/usr/bin/env node
import { spawn } from "node:child_process"
import { existsSync } from "node:fs"
import { createRequire } from "node:module"
import { dirname, join } from "node:path"
import { fileURLToPath } from "node:url"

// Platforms with a published native compiler package, effeck-<platform>-<arch>.
const platforms = ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64", "win32-arm64", "win32-x64"]
const executable = process.platform === "win32" ? "effeck.exe" : "effeck"

// findBinary returns the native compiler: EFFECK_BINARY, else native/effeck
// beside this package (a checkout build), else the installed platform package.
function findBinary() {
  if (process.env.EFFECK_BINARY) return process.env.EFFECK_BINARY
  const local = fileURLToPath(new URL(`../native/${executable}`, import.meta.url))
  if (existsSync(local)) return local
  const target = `${process.platform}-${process.arch}`
  try {
    const manifest = createRequire(import.meta.url).resolve(`effeck-${target}/package.json`)
    return join(dirname(manifest), "bin", executable)
  } catch {
    console.error(`effeck: no native compiler is installed for ${target}.`)
    console.error(`effeck ships native compilers for ${platforms.join(", ")}.`)
    if (platforms.includes(target)) {
      console.error(`Reinstall without omitting optional dependencies so effeck-${target} installs.`)
    }
    console.error("In an Effeck checkout, run sh scripts/build-effeck.sh, or set EFFECK_BINARY.")
    process.exit(1)
  }
}

const binary = findBinary()
const child = spawn(binary, process.argv.slice(2), { stdio: "inherit" })
const signals = ["SIGINT", "SIGTERM", "SIGHUP"]
for (const signal of signals) process.on(signal, () => child.kill(signal))
child.on("error", (error) => {
  console.error(`effeck: cannot run ${binary}: ${error.message}`)
  console.error("Run sh scripts/build-effeck.sh from the Effeck repository, or set EFFECK_BINARY.")
  process.exitCode = 1
})
child.on("exit", (code, signal) => {
  if (signal) {
    process.removeAllListeners(signal)
    process.kill(process.pid, signal)
  } else process.exitCode = code ?? 1
})
