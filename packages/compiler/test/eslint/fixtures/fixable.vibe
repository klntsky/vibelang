/**
 * Violations ESLint fixes; fixable.expected.vibe is the result.
 *
 * @since 0.0.2
 */

import { User } from "./models.vibe"
import { Users } from "./services.vibe"

/**
 * Finds users.
 *
 * @category constructors
 * @since 0.0.2
 */
export function list(ids: string[]): Effect<ReadonlyArray<User>, never, Users> {
  let found = ids |> %.map((id) => Users.find(id))
  return found
}
