{
  "name": "vibelang",
  "version": "0.0.2",
  "description": "The VibeLang compiler and language server: a readable syntax for Effect that compiles to TypeScript",
  "keywords": ["vibelang", "effect", "typescript", "compiler", "language-server"],
  "homepage": "https://effeck.dev",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./project": { "types": "./project.d.mts", "default": "./project.mjs" },
    "./register": "./register.mjs",
    "./eslint": "./eslint.mjs"
  },
  "bin": { "vibelang": "bin/vibelang" },
  "files": ["bin", "editor", "dprint-plugin.json", "eslint.mjs", "project.mjs", "project.d.mts", "register.mjs", "README.md", "LICENSE", "NOTICE"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "optionalDependencies": {
    "vibelang-darwin-arm64": "0.0.2",
    "vibelang-darwin-x64": "0.0.2",
    "vibelang-linux-arm64": "0.0.2",
    "vibelang-linux-x64": "0.0.2",
    "vibelang-win32-arm64": "0.0.2",
    "vibelang-win32-x64": "0.0.2"
  },
  "engines": { "node": ">=22" }
}
