{
  "name": "vibelang-runtime",
  "version": "0.0.3",
  "description": "The VibeLang continuation kernel and generated-code runtime helpers.",
  "keywords": [
    "vibelang",
    "effect",
    "runtime",
    "continuations"
  ],
  "homepage": "https://vibelang.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/vibelang.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/smithersai/vibelang/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/kernel.d.ts",
      "import": "./dist/kernel/kernel.js",
      "default": "./dist/kernel/kernel.js"
    },
    "./data-methods": {
      "types": "./dist/data-methods.d.ts",
      "import": "./dist/data-methods.js",
      "default": "./dist/data-methods.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && bun test"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "effect": "4.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26",
    "bun": ">=1.4"
  }
}
