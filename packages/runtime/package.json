{
  "name": "effeck-runtime",
  "version": "0.0.1",
  "description": "The Effeck continuation kernel and generated-code runtime helpers.",
  "keywords": [
    "effeck",
    "effect",
    "runtime",
    "continuations"
  ],
  "homepage": "https://effeck.dev",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/kernel.d.ts",
      "import": "./dist/kernel/kernel.js",
      "default": "./dist/kernel/kernel.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && bun test"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "effect": "4.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26",
    "bun": ">=1.4"
  }
}
