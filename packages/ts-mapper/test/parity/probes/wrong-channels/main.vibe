// A probe: each contract below is wrong in one channel, so checking the
// body against it must fail on the mapper side, as it does in the fork.
export class Boom extends Error {}

abstract class Needed {
  abstract lookup(): Effect<number>
}

function fails(n: number): Effect<number, Boom> {
  if (n < 0) throw new Boom("negative")
  return n
}

export function wrongSuccess(): Effect<string, Boom> {
  return fails(1) // probe-error: TS2322 number
}

export function wrongError(n: number): Effect<number> {
  return fails(n) // probe-error: TS2322 Boom
}

export function wrongRequirement(): Effect<number> {
  return Needed.lookup() // probe-error: TS2322 Needed
}
