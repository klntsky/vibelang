{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "target": "es2024",
    "skipLibCheck": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "out"
  },
  "contentMappers": [
    { "package": "vibelang-ts-mapper", "extensions": [".vibe"], "outputExtensions": { ".vibe": ".js" } }
  ],
  "include": ["src"]
}
