import { NodeRuntime } from "@effect/platform-node"
import { EmptyName, greeting } from "./greeting.effeck"

service Greeter {
  greet(name: string): string!EmptyName
}

layer GreeterLive: Greeter {
  greet(name: string) { return greeting(name) }
}

export function main() {
  Effect.provide(() => {
    Console.log(Greeter.greet("Effeck"))
    try {
      Greeter.greet("")
    } catch (error) {
      Console.log(`Recovered from ${error._tag}`)
    }
  }, GreeterLive)
}

NodeRuntime.runMain(() => main())
