import { assert, it } from "@effect/vitest"
import { TestClock } from "effect/testing"
import { deadline, fetchReport, scenario } from "./main.effeck"

it.effect("retries, races and joins under virtual time", () => {
  const pending = fork(scenario())
  TestClock.adjust("1 second")
  const result = Fiber.join(pending)
  Effect.sync(() => assert.deepStrictEqual(result, {
    fastest: "cached report", timed: "TimeoutError", report: "report after 3 attempts"
  }))
})

it.effect("does not finish retries before their scheduled time", () => {
  const completed = Deferred.make<string>()
  const pending = fork(() => {
    const report = fetchReport()
    Deferred.succeed(completed, report)
    return report
  })
  TestClock.adjust("19 millis")
  const before = Deferred.isDone(completed)
  Effect.sync(() => assert.isFalse(before))
  TestClock.adjust("1 millis")
  const report = Fiber.join(pending)
  Effect.sync(() => assert.strictEqual(report, "report after 3 attempts"))
})

it.effect("interrupts a slow request at its deadline", () => {
  const pending = fork(deadline())
  TestClock.adjust("20 millis")
  const result = Fiber.join(pending)
  Effect.sync(() => assert.strictEqual(result, "TimeoutError"))
})
